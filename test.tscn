[sub_resource type="Environment" id="Environment_ehkex"]
background_mode = 1
ambient_light_source = 2
ambient_light_color = Color(1, 1, 1, 1)

[sub_resource type="GDScript" id="GDScript_g14j6"]
script/source = "extends Node2D

@export var camera: Camera3D
@export var player: CharacterBody3D

func _process(delta: float) -> void:
	queue_redraw()

func _draw() -> void:
	var from: Vector2 = camera.unproject_position(player.global_position)
	var to: Vector2 = camera.unproject_position(player.global_position + player.move_dir * 2.0)
	draw_line(from, to, Color.RED)
	
	to = camera.unproject_position(player.global_position + player.aim_dir * 2.0)
	draw_line(from, to, Color.BLUE)
	
	to = camera.unproject_position(player.global_position + player.thrust_dir * 2.0)
	draw_line(from, to, Color.PURPLE)
	
	to = camera.unproject_position(player.global_position + player.facing_dir * 2.0)
	draw_line(from, to, Color.GREEN)
"

